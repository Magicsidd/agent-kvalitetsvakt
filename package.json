{
  "name": "agent-kvalitetsvakt",
  "version": "0.1.0",
  "private": true,
  "description": "Norsk AI-telefonagent med booking-integrasjon, evaluering og dashbord",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server/start.ts",
    "start": "tsx src/server/start.ts",
    "eval": "tsx src/eval/run.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "nettlesertest": "tsx scripts/nettlesertest.ts",
    "rapport": "tsx scripts/kvalitetsrapport.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "author": "Kristian Pedersen"
}
